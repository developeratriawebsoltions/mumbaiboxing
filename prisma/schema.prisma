generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model academy {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique(map: "Academy_userId_key")
  name             String
  address          String?
  phone            String?
  membershipExpiry DateTime?
  createdAt        DateTime  @default(now())

  user    user      @relation(fields: [userId], references: [id], map: "Academy_userId_fkey")
  boxer   boxer[]
  coach   coach[]
  payment payment[]
}

model boxer {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique(map: "Boxer_userId_key")
  name             String
  dob              DateTime?
  gender           String?
  phone            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  photo            String?
  category         String?
  weight           String?
  weightCategory   String?
  ageGroup         String?
  academyId        Int?
  rank             Int?
  membershipExpiry DateTime?
  createdAt        DateTime  @default(now())

  academy           academy?                   @relation(fields: [academyId], references: [id], map: "Boxer_academyId_fkey")
  user              user                       @relation(fields: [userId], references: [id], map: "Boxer_userId_fkey")
  certificate       certificate[]
  medical           medical?
  payment           payment[]
  tournamententry   tournamententry[]
  tournamentHistory boxer_tournament_history[]
  points            boxer_points[]

  @@index([academyId], map: "Boxer_academyId_fkey")
}

model certificate {
  id             Int  @id @default(autoincrement())
  boxerId        Int?
  coachId        Int?
  refereeJudgeId Int?

  type     String
  event    String
  issuedAt DateTime @default(now())
  qrStatus String   @default("verified")

  boxer        boxer?         @relation(fields: [boxerId], references: [id], map: "Certificate_boxerId_fkey")
  coach        coach?         @relation(fields: [coachId], references: [id], map: "Certificate_coachId_fkey")
  refereeJudge referee_judge? @relation(fields: [refereeJudgeId], references: [id], map: "Certificate_refereeJudgeId_fkey")

  @@index([boxerId], map: "Certificate_boxerId_fkey")
  @@index([coachId], map: "Certificate_coachId_fkey")
  @@index([refereeJudgeId], map: "Certificate_refereeJudgeId_fkey")
}

model coach {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique(map: "Coach_userId_key")
  name             String
  phone            String?
  academyId        Int?
  membershipExpiry DateTime?
  createdAt        DateTime  @default(now())

  certificate certificate[]
  academy     academy?      @relation(fields: [academyId], references: [id], map: "Coach_academyId_fkey")
  user        user          @relation(fields: [userId], references: [id], map: "Coach_userId_fkey")
  payment     payment[]

  @@index([academyId], map: "Coach_academyId_fkey")
}

model referee_judge {
  id     Int @id @default(autoincrement())
  userId Int @unique(map: "RefereeJudge_userId_key")

  name   String
  phone  String?
  dob    DateTime?
  gender String?

  designation           String?
  officiatingLevel      String?
  qualification         String?
  officiatingExperience String?
  federationAffiliation String?

  aadhaarPan            String?
  tournamentsOfficiated String?
  achievements          String?

  address          String?
  membershipExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                   user                       @relation(fields: [userId], references: [id], map: "RefereeJudge_userId_fkey")
  payment                payment[]
  certificate            certificate[]
  refereeJudgeTournament referee_judge_tournament[]

  @@index([designation])
  @@index([officiatingLevel])
}

model document {
  id              Int      @id @default(autoincrement())
  userId          Int
  label           String
  filePath        String
  fileType        String
  status          String   @default("Pending")
  rejectionReason String?
  createdAt       DateTime @default(now())

  user user @relation(fields: [userId], references: [id], map: "Document_userId_fkey")

  @@unique([userId, label], map: "Document_userId_label_key")
}

model medical {
  id            Int       @id @default(autoincrement())
  boxerId       Int       @unique(map: "Medical_boxerId_key")
  fitnessStatus String    @default("Valid")
  expiryDate    DateTime?
  injury        String?   @default("None")
  eligible      Boolean   @default(true)
  updatedAt     DateTime
  createdAt     DateTime  @default(now())

  boxer boxer @relation(fields: [boxerId], references: [id], map: "Medical_boxerId_fkey")
}

model payment {
  id             Int  @id @default(autoincrement())
  boxerId        Int?
  coachId        Int?
  academyId      Int?
  refereeJudgeId Int?

  type             String
  amount           Int
  method           String?
  status           String    @default("Pending")
  membershipExpiry DateTime?
  createdAt        DateTime  @default(now())

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  isDeveloperBypass Boolean @default(false)
  invoiceNumber     String? @unique

  academy      academy?       @relation(fields: [academyId], references: [id], map: "Payment_academyId_fkey")
  boxer        boxer?         @relation(fields: [boxerId], references: [id], map: "Payment_boxerId_fkey")
  coach        coach?         @relation(fields: [coachId], references: [id], map: "Payment_coachId_fkey")
  refereeJudge referee_judge? @relation(fields: [refereeJudgeId], references: [id], map: "Payment_refereeJudgeId_fkey")

  @@index([academyId], map: "Payment_academyId_fkey")
  @@index([boxerId], map: "Payment_boxerId_fkey")
  @@index([coachId], map: "Payment_coachId_fkey")
  @@index([refereeJudgeId], map: "Payment_refereeJudgeId_fkey")
}

model tournament {
  id          Int       @id @default(autoincrement())
  name        String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  weightClass String?
  status      String    @default("upcoming")
  entryFee    Int?      @default(500)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  tournamententry        tournamententry[]
  refereeJudgeTournament referee_judge_tournament[]
}

model tournamententry {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  boxerId      Int
  createdAt    DateTime @default(now())

  boxer      boxer      @relation(fields: [boxerId], references: [id], map: "TournamentEntry_boxerId_fkey")
  tournament tournament @relation(fields: [tournamentId], references: [id], map: "TournamentEntry_tournamentId_fkey")

  @@index([boxerId], map: "TournamentEntry_boxerId_fkey")
  @@index([tournamentId], map: "TournamentEntry_tournamentId_fkey")
}

model referee_judge_tournament {
  id             Int @id @default(autoincrement())
  refereeJudgeId Int
  tournamentId   Int

  role       String   @default("Referee")
  status     String   @default("ASSIGNED")
  assignedAt DateTime @default(now())
  notes      String?

  refereeJudge referee_judge @relation(fields: [refereeJudgeId], references: [id], onDelete: Cascade, map: "RefereeJudgeTournament_refereeJudgeId_fkey")
  tournament   tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade, map: "RefereeJudgeTournament_tournamentId_fkey")

  @@unique([refereeJudgeId, tournamentId], map: "RefereeJudgeTournament_refereeJudgeId_tournamentId_key")
  @@index([refereeJudgeId])
  @@index([tournamentId])
  @@index([status])
}

model user {
  id        Int       @id @default(autoincrement())
  email     String    @unique(map: "User_email_key")
  password  String
  role      user_role
  createdAt DateTime  @default(now())
  updatedAt DateTime

  registrationStatus    String    @default("PAYMENT_PENDING")
  membershipId          String?   @unique
  membershipValidFrom   DateTime?
  membershipExpiry      DateTime?
  membershipActivatedAt DateTime?

  academy       academy?
  boxer         boxer?
  coach         coach?
  refereeJudge  referee_judge?
  document      document[]
  notifications notification[]
}

enum user_role {
  boxer
  coach
  academy
  referee_judge
  association
  school
  taluka
  admin
  superadmin
}

model notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model boxer_tournament_history {
  id Int @id @default(autoincrement())

  boxerId Int

  tournamentName String
  location       String?
  tournamentDate DateTime?
  tournamentType String?
  weightCategory String?

  result   String?
  medal    String?
  position Int?

  coachName String?
  notes     String?

  documentPath String?
  documentName String?

  status          String  @default("PENDING_REVIEW")
  rejectionReason String?

  reviewedBy Int?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boxer boxer @relation(fields: [boxerId], references: [id], map: "BoxerTournamentHistory_boxerId_fkey")

  points boxer_points?

  @@index([boxerId], map: "BoxerTournamentHistory_boxerId_fkey")
  @@index([status], map: "BoxerTournamentHistory_status_idx")
  @@index([tournamentDate], map: "BoxerTournamentHistory_tournamentDate_idx")
}

model boxer_points {
  id        Int @id @default(autoincrement())
  boxerId   Int
  historyId Int @unique

  tournamentName String
  tournamentType String
  medal          String
  points         Int
  season         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boxer   boxer                    @relation(fields: [boxerId], references: [id])
  history boxer_tournament_history @relation(fields: [historyId], references: [id])

  @@index([boxerId])
  @@index([season])
  @@index([points])
}
